{
  "name": "@superdoc/docx-engine",
  "version": "0.4.0",
  "license": "SEE LICENSE IN DOCX-ENGINE-LICENSE.md",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://www.superdoc.dev/",
  "bugs": {
    "url": "https://www.superdoc.dev/"
  },
  "type": "module",
  "files": [
    "dist",
    "dist-cdn",
    "README.md",
    "DOCX-ENGINE-LICENSE.md",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES",
    "build/license-banner.txt",
    "scripts/verify-package.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/docx-engine.d.ts",
      "import": "./dist/docx-engine.es.js",
      "default": "./dist/docx-engine.es.js"
    },
    "./collaboration-upgrade-engine": {
      "types": "./dist/collaboration-upgrade-engine.d.ts",
      "import": "./dist/collaboration-upgrade-engine.js",
      "require": "./dist/collaboration-upgrade-engine.cjs",
      "default": "./dist/collaboration-upgrade-engine.js"
    },
    "./cdn": "./dist-cdn/docx-engine.es.js",
    "./cdn/style.css": "./dist-cdn/style.css",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/docx-engine.es.js",
  "module": "./dist/docx-engine.es.js",
  "types": "./dist/docx-engine.d.ts",
  "peerDependencies": {
    "@hocuspocus/provider": "^2.13.6",
    "@liveblocks/client": "^3.15.5",
    "@liveblocks/yjs": "^3.15.5",
    "vue": "^3.5.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.19"
  },
  "peerDependenciesMeta": {
    "@hocuspocus/provider": {
      "optional": true
    },
    "@liveblocks/client": {
      "optional": true
    },
    "@liveblocks/yjs": {
      "optional": true
    },
    "y-websocket": {
      "optional": true
    }
  },
  "dependencies": {
    "xml-js": "1.6.11"
  }
}