{
  "name": "superdoc-timeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "superdoc:workers": "node scripts/copy-superdoc-workers.mjs",
    "predev": "node scripts/copy-superdoc-workers.mjs && node scripts/copy-prototypes.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-superdoc-workers.mjs && node scripts/copy-prototypes.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.2.1",
    "superdoc": "2.5.1",
    "yjs": "13.6.32",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "y-websocket": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
